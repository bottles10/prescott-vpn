<% if model_name.errors.any? %>
        <div id="error-explanation" class="mb-4 border border-red-400 rounded">
            <p class="p-1 text-lg bg-red-600 text-red-100"><%= pluralize(model_name.errors.count, 'error')%> prohibited this <%= model_name.model_name.human %> from logging in. </p>

            <div class="p-2 list-disc list-inside">
                    <p class="text-red-600">Wrong username or password</p>
            </div>
        </div>
    <% end %>